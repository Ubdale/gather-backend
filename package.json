{
  "name": "gather-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "plan": "node --env-file-if-exists=.env scripts/plans.cjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.cjs",
    "account": "node --env-file-if-exists=.env scripts/account.cjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.cjs",
    "import:sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "dotenv": "^17.2.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3"
  }
}
